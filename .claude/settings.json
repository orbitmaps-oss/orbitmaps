{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(gradlew.bat:*)",
      "Bash(python scripts/check_dependencies.py:*)",
      "Bash(python scripts/check_forbidden_files.py:*)",
      "Bash(python scripts/check_offline.py:*)",
      "Bash(python scripts/check_permissions.py:*)",
      "Bash(python -m unittest discover:*)",
      "Bash(python3 scripts/check_dependencies.py:*)",
      "Bash(python3 scripts/check_forbidden_files.py:*)",
      "Bash(python3 scripts/check_offline.py:*)",
      "Bash(python3 scripts/check_permissions.py:*)",
      "Bash(python3 -m unittest discover:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote -v)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(gh pr create:*)",
      "Bash(python -I pipeline/sample_region/fetch_sample_region.py:*)",
      "Edit(/config/**)",
      "Edit(/scripts/check_*)",
      "Edit(/scripts/policy.py)",
      "Edit(/.github/workflows/**)",
      "Edit(/gradle/libs.versions.toml)",
      "Edit(/gradle/verification-metadata.xml)",
      "Edit(/.claude/settings.json)",
      "Edit(/.githooks/**)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git -c * push:*)",
      "Bash(wrangler deploy:*)",
      "Bash(wrangler publish:*)",
      "Bash(wrangler secret:*)",
      "Bash(wrangler r2 object put:*)",
      "Bash(wrangler r2 object delete:*)",
      "Bash(wrangler d1 execute:*)",
      "Bash(wrangler d1 migrations apply:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler publish:*)",
      "Bash(npx wrangler secret:*)",
      "Bash(npx wrangler r2 object put:*)",
      "Bash(npx wrangler r2 object delete:*)",
      "Bash(npx wrangler d1 execute:*)",
      "Bash(npx wrangler d1 migrations apply:*)",
      "Bash(gh release create:*)",
      "Bash(gh release upload:*)",
      "Bash(gh pr merge:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Read(**/local.properties)",
      "Read(**/google-services.json)",
      "Read(**/keystore.properties)",
      "Read(**/signing.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.dev.vars)",
      "Edit(**/.dev.vars.*)",
      "Edit(**/google-services.json)",
      "Edit(**/keystore.properties)"
    ]
  }
}
