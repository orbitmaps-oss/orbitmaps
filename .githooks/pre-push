#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Runs before every push: refuses pushes to main and runs the same checks as CI.
set -eu
. "$(git rev-parse --show-toplevel)/.githooks/common.sh"

# Git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        fail "Pushing to main is not allowed. Push your branch and open a pull request."
    fi
done

echo "pre-push: running ./gradlew checkAll (same checks as CI, takes a few minutes)..."
./gradlew --quiet checkAll || fail "checkAll failed; fix it before pushing."
